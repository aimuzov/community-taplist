{
	"name": "community-taplist",
	"description": "Digital tap list for a craft beer bar: TV screens plus a web editor, backed by a GitHub Gist",
	"private": true,
	"type": "module",
	"version": "1.0.0",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aimuzov/community-taplist.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"engines": {
		"node": ">=22",
		"npm": ">=10"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.5.25",
		"@sveltejs/vite-plugin-svelte": "3.1.2",
		"@types/eslint": "9.6.1",
		"@types/node": "22.20.4",
		"eslint": "9.9.1",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-svelte": "2.43.0",
		"globals": "15.9.0",
		"prettier": "3.1.1",
		"prettier-plugin-svelte": "3.2.6",
		"svelte": "4.2.19",
		"svelte-check": "3.8.6",
		"typescript": "5.5.4",
		"typescript-eslint": "8.3.0",
		"vite": "5.4.2",
		"vite-plugin-devtools-json": "0.3.0"
	},
	"dependencies": {
		"@octokit/core": "7.0.3",
		"svelte-forms-lib": "2.0.1"
	}
}
