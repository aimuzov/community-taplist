{
	"name": "community-taplist",
	"type": "module",
	"changelog": true,
	"version": "2.6.0",
	"private": true,
	"description": "Электронный таплист крафтового бара: табло на телевизорах и веб-редактор, данные в GitHub Gist",
	"license": "MIT",
	"engines": {
		"node": "26.11.1"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"check": "astro check && svelte-check",
		"test": "node --test 'src/**/*.test.ts'",
		"test:e2e": "playwright test",
		"astro": "astro",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint:css": "stylelint \"src/**/*.{css,astro,svelte}\"",
		"lint:js": "oxlint --deny-warnings",
		"api": "node --watch --env-file-if-exists=.env src/backend/server.ts"
	},
	"devDependencies": {
		"@aimuzov/infra-site-kit": "github:aimuzov/infra-site-kit#661bf5760d9fda3c0ba6bd35ddb4cbb4537aa929",
		"@astrojs/check": "0.9.12",
		"@astrojs/svelte": "9.1.6",
		"@fontsource/arsenal": "5.3.0",
		"@fontsource/blinker": "5.3.0",
		"@lucide/svelte": "1.77.0",
		"@playwright/test": "1.65.1",
		"@sentry/browser": "11.9.0",
		"@types/node": "26.6.6",
		"astro": "7.4.13",
		"conventional-commits-filter": "5.0.0",
		"lucide-static": "1.77.0",
		"oxlint": "1.94.0",
		"prettier": "3.10.1",
		"stylelint": "17.16.0",
		"svelte": "5.58.0",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3"
	},
	"imports": {
		"#frontend/*": "./src/frontend/*",
		"#backend/*": "./src/backend/*",
		"#shared/*": "./src/shared/*"
	},
	"dependencies": {
		"@aimuzov/infra-node-kit": "github:aimuzov/infra-node-kit#52a4c6048915370f2e814fbac690ef7c49025b2e",
		"@sentry/node": "11.9.0"
	}
}
