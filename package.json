		"@sveltejs/vite-plugin-svelte": "3.1.2",
		"@types/eslint": "9.6.1",
		"eslint": "9.9.1",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-svelte": "2.43.0",
		"globals": "15.9.0",
		"prettier": "3.1.1",
		"prettier-plugin-svelte": "3.2.6",
		"svelte": "4.2.19",
		"svelte-check": "3.8.6",
		"typescript": "5.5.4",
		"typescript-eslint": "8.3.0",
		"vite": "5.4.2",
