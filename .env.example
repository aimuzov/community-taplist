# Editor Basic Auth credentials in "user:password" form. The editor is locked while this is empty.
PRIVATE_EDITOR_SECRET=

# GitHub token with the "gist" scope only (a fine-grained token with Gists: read and write).
# Leave empty in development to run on built-in sample data.
PRIVATE_GITHUB_API_TOKEN=
# ID of the gist that stores the tap list (the hash at the end of the gist URL).
PRIVATE_GITHUB_GIST_ID=
# File inside the gist, e.g. taplist.json.
PRIVATE_GITHUB_GIST_FILENAME=

# 1 -- read the gist once and keep it in memory (the editor refreshes it on save).
# Anything else -- read the gist on every request.
PRIVATE_CACHE=1

# How often TV screens reload, in milliseconds. Defaults to 60000.
PUBLIC_DATA_UPDATE_INTERVAL=60000

# Public URL of the app, required by adapter-node behind a reverse proxy (production only).
ORIGIN=
