# Переменные сайта и API. На сервере лежат в /srv/community-taplist/.env, в git не попадают.
# Файл нужен даже пустым: compose передаёт его в Dockerfile сайта секретом.

# Как часто табло забирает свежий список, в миллисекундах. По умолчанию 60000.
# Это переменная сборки: после изменения сайт нужно пересобрать.
PUBLIC_DATA_UPDATE_INTERVAL=60000

# Каталог со списком кранов и его историей. В образе API это /data (volume), локально по
# умолчанию .data в корне репо.
# DATA_DIR=

# Sentry. Без DSN SDK не включается. PUBLIC_SENTRY_DSN -- переменная сборки браузерного кода
# (и origin для CSP), SENTRY_DSN читает API при старте. DSN один, проект community-taplist.
# PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
